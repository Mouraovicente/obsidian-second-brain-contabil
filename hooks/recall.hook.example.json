// recall.hook.example.json - paste-in template for ~/.claude/settings.json
//
// ON BY DEFAULT whenever OBSIDIAN_VAULT_PATH is set. Bounded vault recall: on
// every prompt, inject a small brief (max 4 notes, ~900 chars) of the most
// relevant vault notes, or nothing at all when confidence is low (abstention).
// Read-only; it never writes to the vault. The plugin already registers it
// (hooks/hooks.json); this file is only for a manual, non-plugin install.
// Use the .sh wrapper, not `python3 ...py`: python3 is a broken stub on Windows.
//
// Every inject/abstain decision is logged to <vault>/.claude-runs/
// recall-YYYY-MM-DD.jsonl so you can audit what got recalled and why.
//
// To DISABLE: set OBSIDIAN_RECALL_ENABLED to "0" in the env block. The gate in
// the script makes that enough, even if the hook stays registered.
{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /absolute/path/to/.claude/skills/obsidian-second-brain/hooks/obsidian-recall.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
