# obsidian-second-brain - local settings
# Copy this file to ~/.config/obsidian-second-brain/.env and fill in the values.
# That path is machine-local - never committed, never synced. Set permissions 600.

# ─── Vault location (required) ──────────────────────────────
# Absolute path to your Obsidian vault root.
OBSIDIAN_VAULT_PATH=

# ─── Auto-open behavior ─────────────────────────────────────
# After a save, Obsidian can open at the new note. Set to 0 to disable
# (e.g. when running batch saves or scheduled).
# RESEARCH_AUTOOPEN=0

# ─── Write-time validator ───────────────────────────────────
# Comma-separated check numbers to switch off in hooks/validate-ai-first.sh,
# e.g. 5 to skip the banned-characters check.
# AI_FIRST_SKIP_CHECKS=5

# ─── Raw chat archive (optional, off by default) ────────────
# When on, /obsidian-save also keeps a redacted copy of the conversation in
# raw/sessions/: what was said, without tool output. A fact the save step
# skipped stays findable after the agent prunes its own transcripts.
# Claude Code only for now.
# OBSIDIAN_SESSION_ARCHIVE=1

# ─── Semantic search embeddings (optional) ──────────────────
# The default backend is Ollama running on THIS machine (OLLAMA_URL, default
# http://localhost:11434): note text never leaves the computer.
# Setting OBSIDIAN_EMBED_BACKEND=openai instead sends note text to the service
# at OBSIDIAN_EMBED_URL. Do not use it with confidential client data.
# OBSIDIAN_EMBED_BACKEND=ollama
# OLLAMA_URL=http://localhost:11434
# OBSIDIAN_EMBED_MODEL=bge-m3
# Folders never embedded (comma-separated), e.g. "wiki/private/,Journal":
# OBSIDIAN_EMBED_EXCLUDE=
